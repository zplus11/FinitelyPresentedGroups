Notebook[{

Cell[CellGroupData[{
Cell["Finitely Presented Groups Package", "GuideTitle",
 CellChangeTimes->{{4.0025046314369564`*^9, 4.002504635690628*^9}},
 CellID->324650058,ExpressionUUID->"1f952e6b-460d-d24f-af00-a3b378ed0693"],

Cell["\<\
FinitelyPresentedGroups provides symbolic finitely presented groups in the \
Wolfram Language. A group is defined by generators and relators, and \
permutation groups, including the named groups such as symmetric and Mathieu \
groups, can be converted to presentations. The paclet computes Todd-Coxeter \
coset enumeration and allows working with group elements as words.\
\>", "GuideAbstract",
 CellChangeTimes->{
  4.002504593317383*^9, {4.0025046370955887`*^9, 4.0025047132383595`*^9}},
 CellID->234341862,ExpressionUUID->"2f917284-8205-e046-a6b3-c7f2c1aa3874"]
}, Open  ]],

