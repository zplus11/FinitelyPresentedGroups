Notebook[{

Cell[CellGroupData[{
Cell["ElementReduce", "ObjectName",
 CellID->553760795,ExpressionUUID->"cc724325-481b-7c4e-9488-ddd51a377292"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b839dd87-2466-4246-99fc-cbdfe9261583"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ElementReduce",
    BaseStyle->"Link",
    ButtonData->"paclet:TaggarFinitelyPresentedGroups/ref/ElementReduce"], "[", 
   RowBox[{
    StyleBox["group", "TI"], ",", 
    StyleBox["word", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0cee38f3-db55-0e4c-a76e-2f84dc71d622"],
 "\[LineSeparator]reduces ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "7993678a-f677-b044-8457-b889e7530322"],
 " using the relators of ",
 Cell[BoxData[
  StyleBox["group", "TI"]], "InlineFormula",ExpressionUUID->
  "dcfe457d-e745-c64b-aeec-a3802248760b"],
 "."
}], "Usage",
 CellChangeTimes->{{4.001831930986044*^9, 4.0018319531721*^9}},
 CellID->60063079,ExpressionUUID->"0e310f64-ea04-5c4f-878c-39dccaef9aac"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "0f47985e-7e9a-394f-a8df-80cdf6c70339"],
 " can be expressed in terms of the generators, or using generator indices."
}], "Notes",
 CellChangeTimes->{{4.001831955948473*^9, 4.0018319858470345`*^9}},
 CellID->23156563,ExpressionUUID->"5e18314c-679b-ac42-a48d-420d246646cb"],

Cell[TextData[{
 "The reduction first cancels adjacent inverse pairs (free reduction), then \
repeatedly deletes any occurrence of a relator of ",
 Cell[BoxData[
  StyleBox["group", "TI"]], "InlineFormula",ExpressionUUID->
  "310acc7a-304e-4c46-b761-7be2086b598a"],
 ", or a cyclic conjugate of a relator or of its inverse."
}], "Notes",
 CellChangeTimes->{{4.0006290971246834`*^9, 4.0006291220481834`*^9}, {
  4.001832005252617*^9, 4.0018320058062115`*^9}},
 CellID->222011026,ExpressionUUID->"61c4f3ab-0bbc-e741-ba5c-66820f414820"],

Cell[TextData[{
 "Only whole relators are deleted, so the result is shorter but is not a \
normal form. Two words that are equal in ",
 Cell[BoxData[
  StyleBox["group", "TI"]], "InlineFormula",ExpressionUUID->
  "a0460b7d-f4c3-5447-b25c-ddd95834cd15"],
 " can have different reductions."
}], "Notes",
 CellChangeTimes->{{4.0006291033042088`*^9, 4.000629128030937*^9}, {
  4.0018320126554737`*^9, 4.001832014385666*^9}},
 CellID->2727083,ExpressionUUID->"ecbabdad-0121-4149-a9bb-aa0d74ba4e15"]
}, Open  ]],

