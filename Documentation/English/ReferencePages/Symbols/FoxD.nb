Cell[TextData[{
 "Using the commutator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", 
   RowBox[{
    StyleBox["a", "TI"], "\[CirclePlus]", 
    StyleBox["b", "TI"], "\[CirclePlus]", 
    SuperscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{"-", "1"}]], "\[CirclePlus]", 
    SuperscriptBox[
     StyleBox["b", "TI"], 
     RowBox[{"-", "1"}]]}]}]], "InlineFormula",ExpressionUUID->
  "8c38d8db-4216-de43-b39d-f625cfb2a812"],
 ":"
}], "ExampleText",
