  RowBox[{"c", "=", 
   RowBox[{"a", "**", "b", "**", 
    SuperscriptBox["a", 
     RowBox[{"-", "1"}]], "**", 
    SuperscriptBox["b", 
     RowBox[{"-", "1"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FoxD", "[", 
  RowBox[{"G", ",", "c", ",", "a"}], "]"}]}], "Input",
