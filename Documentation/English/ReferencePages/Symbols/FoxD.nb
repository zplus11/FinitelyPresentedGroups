  ExpressionUUID->"659c053f-e77e-7349-a476-b09b28b8f256"],
 " for any other generator ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "70544ebe-72c8-a44d-95f4-80949bc3ad32"],
 ", and in general ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
