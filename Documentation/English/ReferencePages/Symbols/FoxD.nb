  "799192f2-4adb-be46-9b69-64e1d79ee083"],
 " obeys the following rules: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    ButtonBox["FoxD",
     BaseStyle->"Link",
     ButtonData->"paclet:Taggar/FinitelyPresentedGroups/ref/FoxD"], "[", 
    RowBox[{
     StyleBox["group", "TI"], ",", 
     StyleBox["g", "TI"], ",", 
     StyleBox["g", "TI"]}], "]"}], "=", "1"}]], "InlineFormula",
  ExpressionUUID->"ea55d67d-fe58-d441-9918-d07339a6a246"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    ButtonBox["FoxD",
