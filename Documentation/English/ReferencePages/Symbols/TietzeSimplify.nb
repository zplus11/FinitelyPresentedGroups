Cell["Convert a permutation group into a finitely presented group:", \
"ExampleText",
 CellChangeTimes->{{4.0043361239829197`*^9, 4.0043361413724136`*^9}},
 CellID->2793073,ExpressionUUID->"9affed02-827a-8b4e-808c-5db173e35b97"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Shallow", "[", 
  RowBox[{"fpg", "=", 
   RowBox[{"FinitelyPresentedGroup", "[", 
    RowBox[{"PermutationGroup", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", "10"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "11"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"5", ",", "7"}], "}"}]}], "}"}], "]"}], ",", 
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"1", ",", "4", ",", "3"}], "}"}], "}"}], "]"}]}], "}"}], 
     "]"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{4.004336142399748*^9, 4.0043361740319977`*^9}},
 CellLabel->"In[1]:=",
 CellID->396215805,ExpressionUUID->"16c84045-b3ca-a746-be5c-b740c0b000ea"],

Cell[BoxData[
 RowBox[{"FinitelyPresentedGroup", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x11", ",", "x12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Power", "[", 
      RowBox[{"\[LeftSkeleton]", "2", "\[RightSkeleton]"}], "]"}], ",", 
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"\[LeftSkeleton]", "3", "\[RightSkeleton]"}], "]"}], ",", 
     RowBox[{"Power", "[", 
      RowBox[{"\[LeftSkeleton]", "2", "\[RightSkeleton]"}], "]"}], ",", 
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"\[LeftSkeleton]", "5", "\[RightSkeleton]"}], "]"}], ",", 
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"\[LeftSkeleton]", "3", "\[RightSkeleton]"}], "]"}], ",", 
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"\[LeftSkeleton]", "3", "\[RightSkeleton]"}], "]"}], ",", 
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"\[LeftSkeleton]", "5", "\[RightSkeleton]"}], "]"}], ",", 
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"\[LeftSkeleton]", "7", "\[RightSkeleton]"}], "]"}], ",", 
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"\[LeftSkeleton]", "8", "\[RightSkeleton]"}], "]"}], ",", 
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"\[LeftSkeleton]", "5", "\[RightSkeleton]"}], "]"}], ",", 
     RowBox[{"\[LeftSkeleton]", "15", "\[RightSkeleton]"}]}], "}"}]}], 
  "]"}]], "Output",
 CellChangeTimes->{4.004336175773815*^9},
 CellLabel->"Out[1]//Shallow=",
 CellID->903249282,ExpressionUUID->"f6ceb7b5-a545-d242-b125-8b53ea75f92f"]
}, Open  ]],

Cell["This has many relators, and can be simplified:", "ExampleText",
 CellChangeTimes->{{4.0043361902173595`*^9, 4.004336200835808*^9}},
 CellID->194321310,ExpressionUUID->"def6593c-c0d4-2e44-a27a-7253673b459a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TietzeSimplify", "[", "fpg", "]"}]], "Input",
 CellChangeTimes->{{4.004336202388729*^9, 4.004336205101757*^9}},
 CellLabel->"In[2]:=",
 CellID->347572500,ExpressionUUID->"bed9bb1e-015b-6e46-8492-431f89c19135"],

Cell[BoxData[
 RowBox[{"FinitelyPresentedGroup", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x11", ",", "x12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["x11", "2"], ",", 
     SuperscriptBox["x12", "3"], ",", 
     RowBox[{
      FractionBox["1", "x11"], "**", "x12", "**", "x11", "**", "x12", "**", 
      "x11", "**", "x12", "**", 
      FractionBox["1", "x11"], "**", "x12"}], ",", 
     RowBox[{"x11", "**", "x12", "**", "x11", "**", 
      FractionBox["1", "x12"], "**", 
      FractionBox["1", "x11"], "**", "x12", "**", 
      FractionBox["1", "x11"], "**", 
      FractionBox["1", "x12"], "**", 
      FractionBox["1", "x11"], "**", "x12", "**", "x11", "**", 
      FractionBox["1", "x12"]}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{4.004336208073286*^9},
 CellLabel->"Out[2]=",
 CellID->775507989,ExpressionUUID->"f5df9458-8bad-c840-8e5c-3bde763eb077"]
}, Open  ]],

