 CellLabel->"In[44]:=",
 CellID->27888606,ExpressionUUID->"6edcbfbc-c361-2541-9576-7b974dda873f"],

Cell[BoxData[
 RowBox[{"FinitelyPresentedGroup", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["x1", "3"], ",", 
     SuperscriptBox["x2", "2"], ",", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x1", "**", "x2"}], ")"}], "2"]}], "}"}]}], "]"}]], "Output",
