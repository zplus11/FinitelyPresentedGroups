Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D3", "=", 
  RowBox[{"FinitelyPresentedGroup", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", "s"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SuperscriptBox["r", "3"], ",", 
      SuperscriptBox["s", "2"], ",", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"s", "**", "r"}], ")"}], "2"]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.000625336213587*^9, 4.000625361638693*^9}, {
  4.0007791412259235`*^9, 4.0007791593670025`*^9}, {4.000779253137287*^9, 
  4.0007792809252186`*^9}},
