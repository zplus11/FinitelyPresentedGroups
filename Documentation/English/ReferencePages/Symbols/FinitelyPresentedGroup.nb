Cell["Construct free products of finitely generated groups:", "ExampleText",
 CellChangeTimes->{{4.00319604312434*^9, 4.003196049807724*^9}},
 CellID->289450326,ExpressionUUID->"004e9b9e-8186-b349-85fe-6f473da88b88"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"FinitelyPresentedGroup", "[", 
    RowBox[{
     RowBox[{"{", "a", "}"}], ",", 
     RowBox[{"{", 
      SuperscriptBox["a", "3"], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"FinitelyPresentedGroup", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "s"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["r", "3"], ",", 
       SuperscriptBox["s", "2"], ",", 
       RowBox[{
        RowBox[{"s", "**", "r"}], "==", 
        RowBox[{
         FractionBox["1", "r"], "**", "s"}]}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.003196057186432*^9, 4.00319609578516*^9}},
 CellLabel->"In[10]:=",
 CellID->188257333,ExpressionUUID->"611fd416-ae9d-b240-9a3d-533c26215286"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"G", "**", "H"}]], "Input",
 CellChangeTimes->{{4.0031960990348034`*^9, 4.0031960999314537`*^9}},
 CellLabel->"In[15]:=",
 CellID->259031710,ExpressionUUID->"b09c73c9-5537-0f4c-b2e9-5d44c8b2d9c6"],

Cell[BoxData[
 RowBox[{"FinitelyPresentedGroup", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "r", ",", "s"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["a", "3"], ",", 
     SuperscriptBox["r", "3"], ",", 
     SuperscriptBox["s", "2"], ",", 
     RowBox[{
      RowBox[{"s", "**", "r"}], "\[Equal]", 
      RowBox[{
       FractionBox["1", "r"], "**", "s"}]}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{4.0031961005911083`*^9, 4.0031961958473625`*^9},
 CellLabel->"Out[15]=",
 CellID->739945180,ExpressionUUID->"d1348e3f-b2ff-7b4d-82e1-0b599d895379"]
}, Open  ]],

