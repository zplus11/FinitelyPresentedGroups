Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D3", "=", 
  RowBox[{"FinitelyPresentedGroup", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", "s"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SuperscriptBox["r", "3"], ",", 
      SuperscriptBox["s", "2"], ",", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"s", "**", "r"}], ")"}], "2"]}], "}"}]}], "]"}]}]], "Input",
