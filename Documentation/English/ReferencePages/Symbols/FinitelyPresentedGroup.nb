 CellID->942946317,ExpressionUUID->"6f450803-726b-df47-9e09-0ebe9303c3de"],

Cell[TextData[{
 "The finitely presented group ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{"G", "|", "R"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"c9e7132f-7ec7-a44b-af05-368c9f72eb33"],
 " is the free group ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", "G", "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "c08bf549-13fd-b648-b3fc-9d7d1014b7d8"],
 " quotiented by the relators ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineMath",ExpressionUUID->
  "c51ed580-452c-4c4e-85c5-8b5387dad373"],
 StyleBox[".",
  Deletable->True]
}], "Notes",
 CellChangeTimes->{{4.0006251989202538`*^9, 4.0006253215163994`*^9}},
 CellID->173018464,ExpressionUUID->"85fa121d-6ee4-b145-a259-828abe0c5520"]
