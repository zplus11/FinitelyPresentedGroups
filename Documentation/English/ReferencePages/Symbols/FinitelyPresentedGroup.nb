Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a262ae41-27a1-cf4e-b9e2-887b5770f96f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FinitelyPresentedGroup",
    BaseStyle->"Link",
    ButtonData->
     "paclet:TaggarFinitelyPresentedGroups/ref/FinitelyPresentedGroup"], "[", 
   RowBox[{
    StyleBox["generators", "TI"], ",", 
