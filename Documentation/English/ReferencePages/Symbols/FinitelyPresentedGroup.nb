Cell[TextData[{
 "Note that this is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["DihedralGroup",
    BaseStyle->"Link"], "[", "3", "]"}]], "InlineFormula",ExpressionUUID->
  "8bd232dc-c124-0149-86f0-0cdc24fd0d77"],
 " and the same can be directly converted into an FPG as follows:"
}], "ExampleText",
 CellChangeTimes->{{4.0007791691220074`*^9, 4.0007791911051292`*^9}},
 CellID->29793125,ExpressionUUID->"286078ae-4a6a-fc40-9321-dac56726d101"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FinitelyPresentedGroup", "@", 
  RowBox[{"DihedralGroup", "[", "3", "]"}]}]], "Input",
 CellChangeTimes->{{4.000779192012409*^9, 4.000779195912607*^9}},
 CellLabel->"In[56]:=",
 CellID->27888606,ExpressionUUID->"6edcbfbc-c361-2541-9576-7b974dda873f"],

Cell[BoxData[
 RowBox[{"FinitelyPresentedGroup", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x1", "**", "x1"}], ",", 
     RowBox[{"x1", "**", "x2", "**", "x1", "**", 
      FractionBox["1", "x2"], "**", 
      FractionBox["1", "x2"]}], ",", 
     RowBox[{"x1", "**", "x2", "**", "x2", "**", 
      FractionBox["1", "x1"], "**", 
      FractionBox["1", "x2"]}], ",", 
     RowBox[{"x2", "**", "x1", "**", "x1", "**", 
      FractionBox["1", "x2"]}], ",", 
     RowBox[{"x2", "**", "x1", "**", "x2", "**", 
      FractionBox["1", "x1"]}], ",", 
     RowBox[{"x2", "**", "x2", "**", "x1", "**", 
      FractionBox["1", "x2"], "**", 
      FractionBox["1", "x1"]}], ",", 
     RowBox[{"x2", "**", "x2", "**", "x2"}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{
  4.0007791964282303`*^9, {4.0007792597319603`*^9, 4.000779269301628*^9}},
 CellLabel->"Out[56]=",
 CellID->22191,ExpressionUUID->"b0f09ed7-a8e8-2543-8479-70d8326b0499"]
}, Open  ]],

