    RowBox[{"a", ",", "b"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", "**", "b", "**", 
     FractionBox["1", "a"], "**", 
     FractionBox["1", "b"]}], "}"}]}], "]"}]], "Output",
