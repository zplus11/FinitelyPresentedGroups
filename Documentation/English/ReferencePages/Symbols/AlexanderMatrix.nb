   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", "**", "b", "**", 
      SuperscriptBox["a", 
       RowBox[{"-", "1"}]], "**", 
      SuperscriptBox["b", 
       RowBox[{"-", "1"}]]}], "}"}]}], "]"}]}]], "Input",
