Cell[TextData[{
 "The group of the torus knot ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "(", 
    RowBox[{"p", ",", "q"}], ")"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"04b7cd25-a232-2d47-906c-df65746febb2"],
 " is  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\:27e8", " ", "x"}], ",", 
    RowBox[{
     RowBox[{"y", "|", 
      SuperscriptBox["x", "p"]}], "=", 
     RowBox[{
      SuperscriptBox["y", "q"], "\:27e9"}]}]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"b4011650-12b0-1343-bc74-1f6f98904cc0"],
 ", with abelianization ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "\[RightTeeArrow]", 
     SuperscriptBox["t", "q"]}], ",", 
    RowBox[{"y", "\[RightTeeArrow]", 
     SuperscriptBox["t", "p"]}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"8bff5299-8799-584a-9e7b-11c3554877ef"],
 ". For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "(", 
    RowBox[{"2", ",", "3"}], ")"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"bbb733e8-14b8-2040-ba3b-66802a70c6af"],
 ", this becomes:"
}], "ExampleText",
 CellChangeTimes->{{4.00227191665106*^9, 4.002272082920376*^9}},
 CellID->479600930,ExpressionUUID->"05c78ed4-6e83-2747-9467-cf19dfa412f2"],

