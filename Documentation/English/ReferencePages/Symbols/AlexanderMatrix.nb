 RowBox[{"FinitelyPresentedGroup", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", "**", "b", "**", "a", "**", 
     FractionBox["1", "b"], "**", 
     FractionBox["1", "a"], "**", 
     FractionBox["1", "b"]}], "}"}]}], "]"}]], "Output",
