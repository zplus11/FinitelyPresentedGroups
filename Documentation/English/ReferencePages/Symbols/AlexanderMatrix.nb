Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"T", "=", 
  RowBox[{"FinitelyPresentedGroup", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", "**", "b", "**", "a", "**", 
      SuperscriptBox["b", 
       RowBox[{"-", "1"}]], "**", 
      SuperscriptBox["a", 
       RowBox[{"-", "1"}]], "**", 
      SuperscriptBox["b", 
       RowBox[{"-", "1"}]]}], "}"}]}], "]"}]}]], "Input",
