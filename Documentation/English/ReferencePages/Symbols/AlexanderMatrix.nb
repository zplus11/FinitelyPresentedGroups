Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"G", "=", 
  RowBox[{"FinitelyPresentedGroup", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", "**", "b", "**", 
      SuperscriptBox["a", 
       RowBox[{"-", "1"}]], "**", 
      SuperscriptBox["b", 
       RowBox[{"-", "1"}]]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.002271388721592*^9, 4.002271399073372*^9}},
