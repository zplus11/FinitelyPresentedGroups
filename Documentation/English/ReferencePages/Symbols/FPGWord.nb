Cell[CellGroupData[{
Cell["FPGWord", "ObjectName",
 CellID->519785359,ExpressionUUID->"332c0a3e-bf77-cc4a-9b24-d7d54de65d2b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f7723008-afe0-af45-b55c-ce34524a672d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FPGWord",
    BaseStyle->"Link",
    ButtonData->"paclet:TaggarFinitelyPresentedGroups/ref/FPGWord"], "[", 
   RowBox[{
    StyleBox["grp", "TI"], ",", 
    StyleBox["indices", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fb53e609-3d54-174f-8202-07d9d8a32a26"],
 "\[LineSeparator]represents a group word in ",
 Cell[BoxData[
  StyleBox["grp", "TI"]], "InlineFormula",ExpressionUUID->
  "c3e1696e-fb02-c548-8e2c-da8cc7fbf314"],
 " determined by ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "93951c99-e08b-a54e-9d6a-b07743eda1f8"],
 "."
}], "Usage",
 CellChangeTimes->{{4.0006266673398952`*^9, 4.0006266675964527`*^9}, {
  4.000627199364403*^9, 4.0006272203092175`*^9}},
 CellID->38773838,ExpressionUUID->"3c67f968-b2e3-8746-8ddb-21b4cc8d7ca1"],

Cell[TextData[{
 "Index ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "f14f9ae3-96a3-f947-be94-4507af20042f"],
 " stands for the ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "85ff70b1-1fec-6e44-b8f7-eb3986580d89"],
 "th generator of ",
 Cell[BoxData[
  StyleBox["grp", "TI"]], "InlineFormula",ExpressionUUID->
  "55f7953d-f037-324d-af01-d076d44a0324"],
 ", and ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"]}]], "InlineFormula",ExpressionUUID->
  "276cbc76-c5d3-9042-9212-ecf0a79a8e72"],
 " for its inverse. The empty list {} is the identity."
}], "Notes",
 CellChangeTimes->{{4.0006271633724136`*^9, 4.000627183666937*^9}, {
  4.000627222766304*^9, 4.0006272337871056`*^9}},
 CellID->277017255,ExpressionUUID->"c9045076-9cba-d943-9824-59ff3783b5d6"],

Cell[TextData[{
 "A word is stored unreduced: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["FPGWord",
    BaseStyle->"Link",
    ButtonData->"paclet:Taggar/FinitelyPresentedGroups/ref/FPGWord"], "[", 
   RowBox[{
    StyleBox["grp", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ce2ba764-7279-9746-b465-358d8c56bdc8"],
 " stays as written until you call ",
 Cell[BoxData[
  ButtonBox["FPGWordReduce",
   BaseStyle->"Link",
   ButtonData->"paclet:Taggar/FinitelyPresentedGroups/ref/FPGWordReduce"]], 
  "InlineFormula",ExpressionUUID->"e857bd81-b1db-f644-8dcb-208e1aa97e8a"],
 "."
}], "Notes",
 CellChangeTimes->{{4.00062724708494*^9, 4.0006272593991623`*^9}},
 CellID->10145741,ExpressionUUID->"05478a15-0400-9742-b7bc-8d0fb99ce450"],

Cell[TextData[{
 "Words in the generators can use ** (",
 Cell[BoxData[
  ButtonBox["NonCommutativeMultiply",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "a7f1e38f-6a86-4d41-952e-b95dfc75a9af"],
 "), powers, and 1 for the identity."
}], "Notes",
 CellChangeTimes->{{4.0006272686305084`*^9, 4.0006272743688774`*^9}},
 CellID->495493172,ExpressionUUID->"8bb86ebf-193c-1f40-ba50-7949ee06e9bd"]
