 RowBox[{"G", "=", 
  RowBox[{"FinitelyPresentedGroup", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "^", "2"}], ",", 
      RowBox[{"b", "^", "3"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "**", "b"}], ")"}], "^", "2"}]}], "}"}]}], 
   "]"}]}]], "Input",
