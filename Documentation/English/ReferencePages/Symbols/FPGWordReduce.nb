    RowBox[{
     SuperscriptBox["a", "2"], ",", 
     SuperscriptBox["b", "3"], ",", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"a", "**", "b"}], ")"}], "2"]}], "}"}]}], "]"}]], "Output",
