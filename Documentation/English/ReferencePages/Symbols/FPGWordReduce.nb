Notebook[{

Cell[CellGroupData[{
Cell["FPGWordReduce", "ObjectName",
 CellID->146305072,ExpressionUUID->"aaabaeb2-70ac-4b4c-b44b-bce15ea741e0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a5d4e7db-83cd-264f-96a2-821744ee08dc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FPGWordReduce",
    BaseStyle->"Link",
    ButtonData->"paclet:TaggarFinitelyPresentedGroups/ref/FPGWordReduce"], "[", 
   StyleBox["word", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "111f1961-4d1b-c74b-83c3-5df2fb558c34"],
 "\[LineSeparator]reduces the given group ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "3a16d92d-7a11-7b4f-b4ff-7aa46a5606ba"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0f7b9bdd-4810-d04a-92ea-e9e492e68fd2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FPGWordReduce",
    BaseStyle->"Link",
    ButtonData->"paclet:TaggarFinitelyPresentedGroups/ref/FPGWordReduce"], "[", 
   RowBox[{
    StyleBox["grp", "TI"], ",", 
    StyleBox["indices", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b2a5c160-f74a-cb49-8fab-b3b405b622ea"],
 "\[LineSeparator]reduces the ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "8a460d28-e03d-e24d-b18c-23ac66c5e145"],
 " given by ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "7fd33d19-0054-6a42-96a3-4578886b9bc0"],
 " in ",
 Cell[BoxData[
  StyleBox["grp", "TI"]], "InlineFormula",ExpressionUUID->
  "b6bac1e0-bad9-b942-b14e-5806348022ee"],
 "."
}], "Usage",
 CellChangeTimes->{{4.000627314093336*^9, 4.000627314426592*^9}, {
  4.0006291065286846`*^9, 4.0006291161979694`*^9}},
 CellID->86129214,ExpressionUUID->"2174e07c-4286-8d41-b4dc-26b41c1579f5"],

Cell[TextData[{
 "The reduction first cancels adjacent inverse pairs (free reduction), then \
repeatedly deletes any occurrence of a relator of ",
 Cell[BoxData[
  StyleBox["grp", "TI"]], "InlineFormula",ExpressionUUID->
  "e4c62396-b4ee-c94f-bf0d-862e3f84a7ff"],
 ", or a cyclic conjugate of a relator or of its inverse."
}], "Notes",
 CellChangeTimes->{{4.0006290971246834`*^9, 4.0006291220481834`*^9}},
 CellID->222011026,ExpressionUUID->"58e80403-9b77-e448-9d5a-9e7af4845a56"],

Cell[TextData[{
 "Only whole relators are deleted, so the result is shorter but is not a \
normal form. Two words that are equal in ",
 Cell[BoxData[
  StyleBox["grp", "TI"]], "InlineFormula",ExpressionUUID->
  "ef1bab09-66bf-fe45-ab5f-d06aa53c751c"],
 " can have different reductions."
}], "Notes",
 CellChangeTimes->{{4.0006291033042088`*^9, 4.000629128030937*^9}},
 CellID->2727083,ExpressionUUID->"054b7921-e015-3244-b302-2c3db1bc87f6"]
}, Open  ]],

