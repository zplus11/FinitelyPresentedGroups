(* ::Text:: *)
(*Main head*)


ClearAll[FinitelyPresentedGroup];
FinitelyPresentedGroup::usage =
	"FinitelyPresentedGroup[generators, relators] represents a finitely presented group.";
FinitelyPresentedGroup::DuplicateGenerators =
	"The generators must be distinct.";
FinitelyPresentedGroup::BadGenerators =
	"Each generator must be an atomic expression.";
FinitelyPresentedGroup::BadRelators =
	"The relators must be valid words in the generators.";
FinitelyPresentedGroup::SymbolDefined =
	"The generator symbol `1` already has definitions or attributes. Clearing them.";
FinitelyPresentedGroup::NotEnumerable =
	"The group could not be enumerated within `1` cosets; it may be infinite.";


(* ::Text:: *)
(*Some properties*)


FinitelyPresentedGroup /: FinitelyPresentedGroup[gens_List, _]["GeneratorList"] :=
	gens
FinitelyPresentedGroup /: FinitelyPresentedGroup[_, rels_List]["RelatorList"] :=
	rels
FinitelyPresentedGroup /: FinitelyPresentedGroup[gens_List, _]["GeneratorCount"] :=
	Length[gens]
FinitelyPresentedGroup /: FinitelyPresentedGroup[_, rels_List]["RelatorCount"] :=
	Length[rels]


FinitelyPresentedGroup /: (G : FinitelyPresentedGroup[gens_List, _])["AbelianInvariants"] :=
	Module[
		{ng = Length[gens], m},
		
		m = Table[Count[w, i] - Count[w, -i],
			{w, DeleteCases[NormaliseRelators[G], {}]}, {i, ng}];
		If[m === {},
			ConstantArray[0, ng],
			DeleteCases[PadRight[Abs @ Diagonal @ SmithReduce[m], ng], 1]]]


(* ::Text:: *)
(*Free group on generators is then the finitely presented group generated by generators subject to no relators:*)


ClearAll[FreeGroup];
FreeGroup::usage =
	"FreeGroup[generators] represents the free group on generators.";


FreeGroup[gens_List] := FinitelyPresentedGroup[gens, {}]


(* ::Text:: *)
(*Parsing group words*)


ParseWord[1, _Association] :=
	{}
ParseWord[x_, map_Association] /; KeyExistsQ[map, x] :=
	{map[x]}
ParseWord[NonCommutativeMultiply[args___], map_Association] :=
	Flatten[ParseWord[#, map] & /@ {args}]
ParseWord[Inverse[x_], map_Association] :=
	Reverse[-ParseWord[x, map]];
ParseWord[x_^n_Integer, map_Association] :=
	If[n >= 0,
		Flatten[ConstantArray[ParseWord[x, map], n]],
		Flatten[ConstantArray[Reverse[-ParseWord[x, map]], -n]]]
ParseWord[x_, map_Association] /; IntegerQ[x] :=
	{x}
ParseWord[_, _Association] := $Failed


(* ::Text:: *)
(*Free reduction*)


FreeReduce[word_List] :=
	Module[
		{stack, top = 0, x},

		stack = ConstantArray[0, Length[word]];
		Do[
			If[top > 0 && stack[[top]] + x == 0,
				top--,
				top++; stack[[top]] = x],
			{x, word}];
		Take[stack, top]]


ValidRelatorsQ[gens_List, rels_List] :=
	Module[
		{map},

		map = AssociationThread[gens, Range[Length[gens]]];
		And @@ (ValidRelatorQ[#, map] & /@ rels)]
ValidRelatorQ[rel_, map_Association] :=
	MatchQ[
		Quiet @ Check[ParseWord[rel, map], $Failed],
		{___Integer}]
ValidRelatorQ[lhs_ == rhs_, map_Association] :=
	ValidRelatorQ[lhs, map] && ValidRelatorQ[rhs, map]


(* ::Text:: *)
(*Invalid forms:*)


FinitelyPresentedGroup[gens_List, rels_List] /; \[Not] DuplicateFreeQ[gens] :=
	(Message[FinitelyPresentedGroup::DuplicateGenerators]; $Failed)
FinitelyPresentedGroup[gens_List, rels_List] /; \[Not] And @@ (AtomQ /@ gens) :=
	(Message[FinitelyPresentedGroup::BadGenerators]; $Failed)
FinitelyPresentedGroup[gens_List, rels_List] /; \[Not] ValidRelatorsQ[gens, rels] :=
	(Message[FinitelyPresentedGroup::BadRelators]; $Failed)


(* ::Subsection:: *)
(*PermutationGroup -> FinitelyPresentedGroup*)


GeneratorSymbols[k_Integer] :=
	Array[Symbol["Global`x" <> ToString[#]] &, k]


FinitelyPresentedGroup[CyclicGroup[n_Integer?Positive]] :=
	Module[
		{a = GeneratorSymbols[1]},
		
		FinitelyPresentedGroup[a, a^n]]


FinitelyPresentedGroup[DihedralGroup[n_Integer?Positive]] :=
	Module[
		{a, b},
		
		{a, b} = GeneratorSymbols[2];
		FinitelyPresentedGroup[{a, b}, {a^n, b^2, (a ** b)^2}]]


FinitelyPresentedGroup[AbelianGroup[ns : {__Integer?Positive}]] :=
	Module[
		{x = GeneratorSymbols[Length[ns]]},
		
		FinitelyPresentedGroup[x,
			Join[
				MapThread[#1^#2 &, {x, ns}],
				(#1 ** #2 ** #1^-1 ** #2^-1 &) @@@ Subsets[x, {2}]]]]


FinitelyPresentedGroup[SymmetricGroup[n_Integer /; n >= 2]] :=
	Module[
		{s = GeneratorSymbols[n - 1]},
		
		FinitelyPresentedGroup[s,
			Join[
				#^2 & /@ s,
				Table[(s[[i]] ** s[[i + 1]])^3, {i, n - 2}],
				Flatten @ Table[(s[[i]] ** s[[j]])^2, {i, n - 1}, {j, i + 2, n - 1}]]]]


FinitelyPresentedGroup[group : Alternatives[
	_PermutationGroup, _CyclicGroup, _DihedralGroup, _SymmetricGroup,
	_AlternatingGroup, _AbelianGroup, _MathieuGroupM11, _MathieuGroupM12,
	_MathieuGroupM22, _MathieuGroupM23, _MathieuGroupM24, _HigmanSimsGroupHS,
	_McLaughlinGroupMcL, _JankoGroupJ1, _JankoGroupJ2, _JankoGroupJ3,
	_JankoGroupJ4, _ConwayGroupCo1, _ConwayGroupCo2, _ConwayGroupCo3,
	_SuzukiGroupSuz, _HeldGroupHe, _RudvalisGroupRu, _FischerGroupFi22,
	_FischerGroupFi23, _FischerGroupFi24Prime, _TitsGroupT, _ONanGroupON,
	_HaradaNortonGroupHN, _ThompsonGroupTh, _LyonsGroupLy, _BabyMonsterGroupB,
	_MonsterGroupM
]] :=
	Module[
		{perms, n, k, words, frontier, h, rels, syms, toWord},

		perms = GroupGenerators[group];
		n = Max[1, PermutationMax /@ perms];
		perms = PermutationList[#, n] & /@ perms;
		k = Length[perms];

		words = <|Range[n] -> {}|>;
		frontier = {Range[n]};
		While[frontier =!= {},
			frontier = Flatten[
				Reap[
					Do[
						h = g[[perms[[i]]]];
						If[\[Not] KeyExistsQ[words, h],
							words[h] = Append[words[g], i];
							Sow[h]],
						{g, frontier}, {i, k}]][[2]],
				1]];

		rels = DeleteDuplicates @ DeleteCases[
			Flatten[
				Table[
					FreeReduce[
						Join[words[g], {i}, InvertWord[words[g[[perms[[i]]]]]]]],
					{g, Keys[words]}, {i, k}],
				1],
			{}];

		syms = GeneratorSymbols[k];

		toWord = Function[w,
			If[w === {},
				1,
				NonCommutativeMultiply @@ (If[# > 0, syms[[#]], syms[[-#]]^-1] & /@ w)]];
		FinitelyPresentedGroup[syms, toWord /@ rels]]


(* ::Subsection:: *)
(*Group properties*)


(* ::Text:: *)
(*Order of a finitely presented group is now merely the index of its coset enumeration by {}:*)


FinitelyPresentedGroup /: GroupOrder[G_FinitelyPresentedGroup] :=
	With[{t = CosetTable[G, {}]}, If[ListQ[t], Length[t], t]]


FinitelyPresentedGroup /: GroupGenerators[G_FinitelyPresentedGroup] :=
	FPGWord[G, #] & /@ G["GeneratorList"]


FinitelyPresentedGroup /: GroupElements[G_FinitelyPresentedGroup] :=
	With[{d = RegularData[G]},
		If[AssociationQ[d], FPGWord[G, #] & /@ d["Words"], $Failed]]


FinitelyPresentedGroup /: GroupElementQ[G_FinitelyPresentedGroup, FPGWord[G_, _List]] :=
	True
FinitelyPresentedGroup /: GroupElementQ[_FinitelyPresentedGroup, _] :=
	False


FinitelyPresentedGroup /:
	GroupElementPosition[G_FinitelyPresentedGroup, FPGWord[G_, w_List]] :=
		With[{d = RegularData[G]},
			If[AssociationQ[d],
				ElementPosition[d["Table"], 2 G["GeneratorCount"], w],
				$Failed]]


FinitelyPresentedGroup /:
	GroupElementToWord[G_FinitelyPresentedGroup, FPGWord[G_, w_List]] :=
		FreeReduce[w]


FinitelyPresentedGroup /:
	GroupElementFromWord[G_FinitelyPresentedGroup, w : {___Integer}] /;
		ValidSubgroupWordQ[w, G["GeneratorCount"]] :=
			FPGWord[G, w]


FinitelyPresentedGroup /: GroupMultiplicationTable[G_FinitelyPresentedGroup] :=
	With[{d = RegularData[G]},
		If[AssociationQ[d],
			With[{t = d["Table"], nc = 2 G["GeneratorCount"]},
				Transpose @ Table[
					Fold[t[[#1, #2]] &, Range @ Length[t], ToColumns[w, nc]],
					{w, d["Words"]}]],
			$Failed]]


FinitelyPresentedGroup /: CayleyGraph[G_FinitelyPresentedGroup] :=
	With[{d = RegularData[G]},
		If[AssociationQ[d],
			CayleyGraph @ PermutationGroup[
				PermutationCycles /@
					Transpose[d["Table"][[All, ;; G["GeneratorCount"]]]]],
			$Failed]]


FinitelyPresentedGroup /: PermutationGroup[G_FinitelyPresentedGroup] :=
	With[
		{d = RegularData[G]},
		
		If[AssociationQ[d],
			PermutationGroup[
				PermutationCycles /@ Transpose[d["Table"][[All, ;; G["GeneratorCount"]]]]],
			$Failed]]


(* ::Subsection:: *)
(*Group words*)


ClearAll[FPGWord];
FPGWord::usage =
	"FPGWord[G, indices] represents a group word in G determined by indices.";
FPGWord::BadWord =
	"The word contains an invalid generator index.";
FPGWord::DifferentGroups =
	"The words belong to different groups.";


FPGWord[FinitelyPresentedGroup[gens_List, rels_List], ints : { _Integer .. }] /;
	\[Not] And @@ (IntegerQ[#] && # =!= 0 && Abs[#] <= Length[gens] &
		/@ ints) :=
			(Message[FPGWord::BadWord]; $Failed)


FPGWord[w_FPGWord] := w


FPGWord[G : FinitelyPresentedGroup[gens_List, rels_List], word : Except[{_Integer ...}]] :=
	Module[
		{map, w},

		map = AssociationThread[gens, Range @ Length[gens]];
		w = ParseWord[word, map];

		If[w === $Failed,
			Message[FPGWord::BadWord]; $Failed,
			FPGWord[G, w]]]


(* ::Text:: *)
(*Order of a word:*)


FPGWord /: FPGWord[G_FinitelyPresentedGroup, w_List]["Order"] :=
	With[
		{d = RegularData[G]},

		If[AssociationQ[d],
			With[
				{lengths = Length /@ First @ PermutationCycles @
					Fold[d["Table"][[#1, #2]] &, Range @ Length[d["Table"]],
						ToColumns[w, 2 G["GeneratorCount"]]]},

				If[lengths === {}, 1, LCM @@ lengths]],
			$Failed]]


(* ::Text:: *)
(*Formatting*)


MakeBoxes[FPGWord[G_, {}], form_] :=
	ToBoxes @ Iconize[FPGWord[G, {}], 1]
MakeBoxes[FPGWord[G_, w_List], form_] :=
	Module[
		{gens = G["GeneratorList"], n, k, u, s},

		n = Length[w];
		k = First @ Select[Range[n], Divisible[n, #] &&
		w === Flatten @ ConstantArray[w[[;; #]], n/#] &, 1];
		u = w[[;; k]];
		s = Row[
			With[
				{x = First[#], m = Length[#]},
				If[x > 0,
					If[m == 1, gens[[x]], Superscript[gens[[x]], m]],
						If[m == 1, Superscript[gens[[-x]], -1],
							Superscript[gens[[-x]], -m]]]] & /@ Split[u]];
		ToBoxes @ Iconize[FPGWord[G, w],
			If[k == n, s, Superscript[Row[{"(", s, ")"}], n/k]]]]


ClearAll[FPGWordQ, FPGWordLength, FPGWordGenerators];
FPGWordQ[FPGWord[G_FinitelyPresentedGroup, word_List]] := True
FPGWordQ[_] := False
FPGWordLength[FPGWord[_, word_List]] := Length[word]
FPGWordGenerators[FPGWord[G_FinitelyPresentedGroup, word_List]] :=
	DeleteDuplicates[Abs /@ word]


ClearAll[SubstituteWord];
SubstituteWord[word_List, images_List] :=
	Flatten[Replace[word, {
		i_Integer /; i > 0 :> images[[i, 2]],
		i_Integer /; i < 0 :> Reverse[-images[[-i, 2]]]
	}, {1}]]


(* ::Text:: *)
(*Word reduction*)


CyclicConjugates[word_List] :=
	If[word === {}, {}, RotateLeft[word, #] & /@ Range[0, Length[word] - 1]]


NormaliseRelator[lhs_ == rhs_, map_Association] :=
	FreeReduce[Join[ParseWord[lhs, map], Reverse[-ParseWord[rhs, map]]]]
NormaliseRelator[rel_, map_Association] :=
	FreeReduce[ParseWord[rel, map]];


NormaliseRelators[FinitelyPresentedGroup[gens_List, rels_List]] :=
	Module[
		{map},

		map = AssociationThread[gens, Range[Length[gens]]];
		NormaliseRelator[#, map] & /@ rels]


$RelatorRulesCache = <||>;
ComputeRelatorRules[G_FinitelyPresentedGroup] :=
	DeleteDuplicates[
		Join @@ (
			Function[r, Join[CyclicConjugates[r], CyclicConjugates[InvertWord[r]]]] /@
				DeleteCases[NormaliseRelators[G], {}])]


RelatorRules[G_FinitelyPresentedGroup] :=
	Module[
		{cached = Lookup[$RelatorRulesCache, G, None], rules},

		If[cached =!= None,
			cached,
			rules = ComputeRelatorRules[G];
			If[MatchQ[rules, {{___Integer} ...}],
				If[Length[$RelatorRulesCache] > 200, $RelatorRulesCache = <||>];
				$RelatorRulesCache[G] = rules];
			rules]]


ReduceByRelators[G_FinitelyPresentedGroup, word_List] :=
	Module[
		{rules = RelatorRules[G], w = FreeReduce[word], changed = True, pos, r},

		While[changed,
			changed = False;
			For[r = 1, r <= Length[rules], r++,
				If[(pos = SequencePosition[w, rules[[r]]]) =!= {},
					pos = First[pos];
					w = FreeReduce[Join[Take[w, pos[[1]] - 1], Drop[w, pos[[2]]]]];
					changed = True;
					Break[]]]];
		w]


ClearAll[FPGWordReduce];
FPGWordReduce::usage =
	"FPGWordReduce[word] reduces the given group word.
FPGWordReduce[G, indices] reduces the word given by indices in G.";


FPGWordReduce[FPGWord[G_FinitelyPresentedGroup, word_List]] :=
	FPGWord[G, ReduceByRelators[G, word]]
FPGWordReduce[G_FinitelyPresentedGroup, word_List] :=
	FPGWordReduce[FPGWord[G, word]]


(* ::Text:: *)
(*Algebra of words*)


FPGWordReduce[$Failed] := $Failed


FPGWord /:
	Inverse[FPGWord[
		G : FinitelyPresentedGroup[gens_List, rels_List],
		word_List
	]] :=
		FPGWordReduce @ FPGWord[G, Reverse[-word]]


FPGWord /: NonCommutativeMultiply[ws : FPGWord[G_FinitelyPresentedGroup, _List] ..] :=
	FPGWordReduce @ FPGWord[G, Join @@ (Last /@ {ws})]
FPGWord /: NonCommutativeMultiply[ws : FPGWord[_FinitelyPresentedGroup, _List] ..] /;
	Length[DeleteDuplicates[First /@ {ws}]] > 1 :=
		(Message[FPGWord::DifferentGroups]; $Failed)


FPGWord /: Power[FPGWord[G_FinitelyPresentedGroup, w_List], n_Integer] :=
	FPGWordReduce @ FPGWord[G,
		If[n >= 0,
			Join @@ ConstantArray[w, n],
			Join @@ ConstantArray[InvertWord[w], -n]]]


FPGWord /: Equal[FPGWord[G_FinitelyPresentedGroup, w1_List],
	FPGWord[G_FinitelyPresentedGroup, w2_List]] /;
		FreeReduce[w1] === FreeReduce[w2] ||
			ReduceByRelators[G, Join[w1, InvertWord[w2]]] === {} :=
				True
FPGWord /: Equal[FPGWord[G_FinitelyPresentedGroup, w1_List],
	FPGWord[G_FinitelyPresentedGroup, w2_List]] /;
		RelatorRules[G] === {} && FreeReduce[w1] =!= FreeReduce[w2] :=
			False


(* ::Text:: *)
(*Word problem - decide by tracing the word through the regular coset table*)


FPGWord /: Equal[FPGWord[G_FinitelyPresentedGroup, w1_List],
	FPGWord[G_FinitelyPresentedGroup, w2_List]] /;
		WordProblem[G, Join[w1, InvertWord[w2]]] === True :=
			True
FPGWord /: Equal[FPGWord[G_FinitelyPresentedGroup, w1_List],
	FPGWord[G_FinitelyPresentedGroup, w2_List]] /;
		WordProblem[G, Join[w1, InvertWord[w2]]] === False :=
			False


